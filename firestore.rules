rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    function validStatus(status) {
      return status in [
        'new',
        'contacted',
        'qualified',
        'proposal-sent',
        'follow-up',
        'closed-won',
        'closed-lost'
      ];
    }

    function validPriority(priority) {
      return priority in ['low', 'normal', 'high', 'urgent'];
    }

    function validPublicCreate() {
      return request.resource.data.keys().hasOnly([
          'fullName',
          'company',
          'email',
          'phone',
          'interest',
          'message',
          'source',
          'status',
          'priority',
          'assignedTo',
          'notes',
          'tags',
          'createdAt',
          'updatedAt',
          'lastContactedAt',
          'userAgent',
          'route',
          'page',
          'analyticsId',
          'activityLog',
          'sessionId',
          'landingPage',
          'currentPage',
          'referrer',
          'utmSource',
          'utmMedium',
          'utmCampaign',
          'channel',
          'deviceType',
          'browser'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.fullName.size() < 120
        && request.resource.data.company is string
        && request.resource.data.company.size() > 1
        && request.resource.data.company.size() < 160
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() < 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 5
        && request.resource.data.phone.size() < 40
        && request.resource.data.interest is string
        && request.resource.data.interest.size() > 0
        && request.resource.data.interest.size() < 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 5
        && request.resource.data.message.size() < 3000
        && request.resource.data.source == 'website-contact-form'
        && request.resource.data.status == 'new'
        && request.resource.data.priority == 'normal'
        && request.resource.data.assignedTo == null
        && request.resource.data.notes == ''
        && request.resource.data.tags.size() == 0
        // Accept server timestamps or client-provided timestamps close to now.
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.updatedAt <= request.time
        && request.resource.data.createdAt >= request.time - duration.value(10, 'm')
        && request.resource.data.updatedAt >= request.time - duration.value(10, 'm')
        && request.resource.data.lastContactedAt == null
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() < 500
        && request.resource.data.route is string
        && request.resource.data.route.size() < 200
        && request.resource.data.page is string
        && request.resource.data.page.size() < 200
        && (!('sessionId' in request.resource.data) || request.resource.data.sessionId == null || (
          request.resource.data.sessionId is string && request.resource.data.sessionId.size() < 80
        ))
        && (!('landingPage' in request.resource.data) || request.resource.data.landingPage == null || (
          request.resource.data.landingPage is string && request.resource.data.landingPage.size() < 300
        ))
        && (!('currentPage' in request.resource.data) || request.resource.data.currentPage == null || (
          request.resource.data.currentPage is string && request.resource.data.currentPage.size() < 200
        ))
        && (!('referrer' in request.resource.data) || request.resource.data.referrer == null || (
          request.resource.data.referrer is string && request.resource.data.referrer.size() < 300
        ))
        && (!('utmSource' in request.resource.data) || request.resource.data.utmSource == null || (
          request.resource.data.utmSource is string && request.resource.data.utmSource.size() < 120
        ))
        && (!('utmMedium' in request.resource.data) || request.resource.data.utmMedium == null || (
          request.resource.data.utmMedium is string && request.resource.data.utmMedium.size() < 120
        ))
        && (!('utmCampaign' in request.resource.data) || request.resource.data.utmCampaign == null || (
          request.resource.data.utmCampaign is string && request.resource.data.utmCampaign.size() < 120
        ))
        && (!('channel' in request.resource.data) || request.resource.data.channel == null || (
          request.resource.data.channel is string && request.resource.data.channel.size() < 40
        ))
        && (!('deviceType' in request.resource.data) || request.resource.data.deviceType == null || (
          request.resource.data.deviceType is string && request.resource.data.deviceType.size() < 30
        ))
        && (!('browser' in request.resource.data) || request.resource.data.browser == null || (
          request.resource.data.browser is string && request.resource.data.browser.size() < 40
        ))
        && (!('analyticsId' in request.resource.data) || (
          request.resource.data.analyticsId == null
          || (request.resource.data.analyticsId is string
            && request.resource.data.analyticsId.size() < 120)
        ))
        && request.resource.data.activityLog.size() == 1
        && request.resource.data.activityLog[0].type == 'created'
        && request.resource.data.activityLog[0].message is string
        && request.resource.data.activityLog[0].message.size() < 500;
    }

    function validAdminUpdate() {
      return request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.fullName.size() < 120
        && request.resource.data.company is string
        && request.resource.data.company.size() > 1
        && request.resource.data.company.size() < 160
        && request.resource.data.email is string
        && request.resource.data.email.size() > 5
        && request.resource.data.email.size() < 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 5
        && request.resource.data.phone.size() < 40
        && request.resource.data.interest is string
        && request.resource.data.message is string
        && request.resource.data.message.size() < 3000
        && request.resource.data.source == resource.data.source
        && validStatus(request.resource.data.status)
        && validPriority(request.resource.data.priority)
        && request.resource.data.notes is string
        && request.resource.data.notes.size() < 5000
        && (!('tags' in request.resource.data) || request.resource.data.tags.size() <= 20)
        && (request.resource.data.assignedTo == null
          || (request.resource.data.assignedTo is string
            && request.resource.data.assignedTo.size() < 120))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.activityLog.size() <= 50;
    }

    match /enquiries/{enquiryId} {
      allow read: if isAdmin();
      allow create: if validPublicCreate();
      allow update: if isAdmin() && validAdminUpdate();
      allow delete: if false;
    }

    function validAnalyticsCreate() {
      return request.resource.data.keys().hasOnly([
          'eventName',
          'eventType',
          'page',
          'path',
          'source',
          'medium',
          'campaign',
          'referrer',
          'ctaLabel',
          'qualificationInterest',
          'corporateInterest',
          'leadId',
          'sessionId',
          'deviceType',
          'browser',
          'createdAt'
        ])
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() > 0
        && request.resource.data.eventName.size() < 80
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() > 0
        && request.resource.data.eventType.size() < 60
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() < 200
        && request.resource.data.page is string
        && request.resource.data.page.size() > 0
        && request.resource.data.page.size() < 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt >= request.time - duration.value(10, 'm')
        && (!('ctaLabel' in request.resource.data) || request.resource.data.ctaLabel == null || (
          request.resource.data.ctaLabel is string && request.resource.data.ctaLabel.size() < 160
        ))
        && (!('leadId' in request.resource.data) || request.resource.data.leadId == null || (
          request.resource.data.leadId is string && request.resource.data.leadId.size() < 120
        ))
        && (!('sessionId' in request.resource.data) || request.resource.data.sessionId == null || (
          request.resource.data.sessionId is string && request.resource.data.sessionId.size() < 80
        ))
        && (!('source' in request.resource.data) || request.resource.data.source == null || (
          request.resource.data.source is string && request.resource.data.source.size() < 120
        ))
        && (!('medium' in request.resource.data) || request.resource.data.medium == null || (
          request.resource.data.medium is string && request.resource.data.medium.size() < 120
        ))
        && (!('campaign' in request.resource.data) || request.resource.data.campaign == null || (
          request.resource.data.campaign is string && request.resource.data.campaign.size() < 120
        ))
        && (!('referrer' in request.resource.data) || request.resource.data.referrer == null || (
          request.resource.data.referrer is string && request.resource.data.referrer.size() < 300
        ))
        && (!('deviceType' in request.resource.data) || request.resource.data.deviceType == null || (
          request.resource.data.deviceType is string && request.resource.data.deviceType.size() < 30
        ))
        && (!('browser' in request.resource.data) || request.resource.data.browser == null || (
          request.resource.data.browser is string && request.resource.data.browser.size() < 40
        ));
    }

    match /analyticsEvents/{eventId} {
      allow create: if validAnalyticsCreate();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
